# ──────────────────────────────────────────────────────────────────────────────
# OutSystems 11 Employee Catalog — REST Test Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# Base URL of your deployed OutSystems 11 EmployeeAPI, following the pattern
#   https://<environment-host>/<ModuleName>/rest/<APIName>
# e.g.:
#   https://your-env.outsystems.app/EmployeeCatalog/rest/EmployeeAPI
#   https://your-server/EmployeeCatalog/rest/EmployeeAPI   (on-premises)
OUTSYSTEMS_BASE_URL=

# Optional API key (sent as X-API-Key header).
# Set this if your OutSystems REST service is protected by an API key.
OUTSYSTEMS_API_KEY=
